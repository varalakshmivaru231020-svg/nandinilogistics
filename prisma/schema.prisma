// NN Infrastructure Developers — Construction ERP & Sales CRM
// Enterprise schema: RBAC, Masters, Projects, Schedule, Material & Inventory, Sales CRM, Units.
// NOTE: Task Management & Checklist Management are intentionally NOT modelled here —
// they are pending client verification. See docs/PENDING_MODULES.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUBMIT
  CANCEL
  LOGIN
  LOGOUT
  LOGIN_FAILED
  EXPORT
  VIEW
  ASSIGN
}

/// What a stage means to the system, whatever Admin names it. Exactly one
/// stage is NEW (where a lead starts); the ONBOARDING kind is the stage that
/// opens the onboarding form; LOST is terminal. The rest are OPEN.
enum LeadStageKind {
  NEW
  OPEN
  ONBOARDING
  LOST
}

/// The lead pipeline, as Masters defines it — add, rename, reorder or disable
/// a stage without a code change. Seeded as New, Interested, Training,
/// Onboarding, Lost.
model LeadStage {
  id        String        @id @default(cuid())
  code      String        @unique
  name      String
  kind      LeadStageKind @default(OPEN)
  sortOrder Int           @default(0)
  status    RecordStatus  @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  leads     Lead[]
  followUps LeadFollowUp[]

  @@map("m_lead_stages")
}

// ---------------------------------------------------------------------------
// IDENTITY & RBAC
// ---------------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  employeeCode       String     @unique
  name               String
  email              String     @unique
  phone              String?
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  /// Bypasses every permission check. Reserved for the platform owner account.
  isSuperAdmin       Boolean    @default(false)
  mustChangePassword Boolean    @default(false)
  designationId      String?
  departmentId       String?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  createdById        String?

  designation  Designation? @relation(fields: [designationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  createdBy    User?        @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]       @relation("UserCreatedBy")

  roles       UserRole[]
  permissions UserPermission[]
  sessions    Session[]
  auditLogs   AuditLog[]

  leadsOwned        Lead[]             @relation("LeadOwner")
  followUps         LeadFollowUp[]
  leadNotes         LeadNote[]
  leadDocuments     LeadDocument[]
  employeeDocuments EmployeeDocument[]
  attendanceEntries AttendanceEntry[]
  settingsUpdated   AppSetting[]       @relation("SettingUpdatedBy")
  notifications     Notification[]     @relation("NotificationRecipient")
  tasksAssigned     TaskAssignee[]     @relation("TaskAssigneeUser")
  tasksCreated      Task[]             @relation("TaskCreatedBy")
  taskEvents        TaskEvent[]        @relation("TaskEventActor")
  taskComments      TaskComment[]      @relation("TaskCommentAuthor")
  taskAttachments   TaskAttachment[]   @relation("TaskAttachmentBy")

  @@index([status])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  /// System roles cannot be deleted or have their code changed.
  isSystem    Boolean      @default(false)
  /// Lower number = higher authority. Used for approval routing and role-guarding.
  level       Int          @default(100)
  /// The permission codes this role falls back to. Set from the shipped matrix
  /// when a role is seeded, and overwritten whenever somebody saves the grants
  /// they have as the new default — which is what makes "restore" mean
  /// something a person chose rather than something the code shipped with.
  defaultCodes Json?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  permissions    RolePermission[]
  users          UserRole[]

  @@index([status])
  @@map("roles")
}

/// The permission catalogue. Every guarded action, tab, list, button, column,
/// export and approval in the platform has exactly one row here.
/// Rows are synced from src/lib/permissions/registry.ts — never hand-edited.
model Permission {
  id          String   @id @default(cuid())
  /// Canonical three-part code: module.resource.action — e.g. "masters.item.create"
  code        String   @unique
  /// Top-level module bucket, e.g. "masters", "material", "sales"
  module      String
  /// Resource within the module, e.g. "item", "indent"
  resource    String
  /// Verb, e.g. "view", "create", "update", "delete", "approve", "export"
  action      String
  label       String
  description String?
  /// UI grouping label for the role-permission matrix screen.
  group       String
  /// Classifies what the permission guards: PAGE | TAB | ACTION | BUTTON | FIELD | REPORT
  kind        String   @default("ACTION")
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
  users UserPermission[]

  @@index([module, resource])
  @@index([group])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Per-user override on top of the roles they hold.
/// DENY always beats ALLOW, and both beat the role grant.
model UserPermission {
  id           String           @id @default(cuid())
  userId       String
  permissionId String
  effect       PermissionEffect @default(ALLOW)
  reason       String?
  createdAt    DateTime         @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
  @@map("user_permissions")
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Full audit trail on every create, edit, approve and delete.
model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  /// Logical entity name, e.g. "Item", "Indent"
  entity    String
  entityId  String?
  /// Human-readable summary shown in the audit viewer.
  summary   String
  /// Field-level before/after diff.
  changes   Json?
  ipAddress String?
  userAgent String?
  projectId String?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// MASTERS
// ---------------------------------------------------------------------------

model Company {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  legalName   String?
  gstin       String?
  pan         String?
  addressLine String?
  cityId      String?
  pincode     String?
  phone       String?
  email       String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  city  City?         @relation(fields: [cityId], references: [id])
  leads LeadCompany[]

  @@map("m_companies")
}

model State {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  gstCode   String?
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  cities City[]

  @@map("m_states")
}

model City {
  id        String       @id @default(cuid())
  name      String
  stateId   String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  state     State     @relation(fields: [stateId], references: [id])
  companies Company[]

  @@unique([name, stateId])
  @@index([stateId])
  @@map("m_cities")
}

model Department {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  description String?
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users        User[]
  designations Designation[]

  @@map("m_departments")
}

model Designation {
  id           String       @id @default(cuid())
  code         String       @unique
  name         String
  departmentId String?
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  users      User[]
  employees  Employee[]

  @@map("m_designations")
}

model LostReason {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  leads Lead[]

  @@map("m_lost_reasons")
}

/// Per-document numbering series — "NL0001".
model NumberingSeries {
  id          String       @id @default(cuid())
  /// Document key: LEAD | RIDER | TASK
  documentKey String
  prefix      String
  /// Optional financial-year token inserted into the generated number.
  fiscalYear  String?
  padding     Int          @default(4)
  nextNumber  Int          @default(1)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([documentKey, fiscalYear])
  @@map("m_numbering_series")
}

/// Organisation-wide settings, one row per key. The value is JSON, validated
/// by the code that reads it, which also supplies the default — so a missing
/// row means "use the default", never an error.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("app_settings")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String?
  href      String?
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// LEADS
// ---------------------------------------------------------------------------

/// What the Capture-lead form asks. The nine system fields map to columns on
/// the lead itself; anything added here is stored in Lead.customFields.
enum LeadFieldType {
  TEXT
  PHONE
  EMAIL
  NUMBER
  DROPDOWN
  DESCRIPTION
  CHECKBOX
  DATE
}

model LeadFormField {
  id        String        @id @default(cuid())
  /// What the form posts under. A system field carries the name the lead
  /// schema already knows; a custom one carries its own id.
  fieldKey  String        @unique
  label     String
  type      LeadFieldType @default(TEXT)
  required  Boolean       @default(false)
  /// A system field is part of the lead record and cannot be removed.
  isSystem  Boolean       @default(false)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("m_lead_form_fields")
}

model Lead {
  id                String    @id @default(cuid())
  leadNo            String    @unique
  name              String
  phone             String
  altPhone          String?
  email             String?
  /// Where the prospective rider is — an area or hub name, as the SOW's "Location".
  location          String?
  stageId           String
  ownerId           String?
  requirement       String?
  /// Set when duplicate detection matches an existing phone/email.
  duplicateOfId     String?
  assignedAt        DateTime?
  /// First response time in minutes — measured, not assumed.
  firstResponseMins Int?
  /// When this lead's overdue follow-up was escalated. Cleared when a follow-up
  /// is logged, so the next lapse can escalate again — but one lapse only once.
  escalatedAt       DateTime?
  nextActionAt      DateTime?
  lostReasonId      String?
  lostNotes         String?
  /// Answers to the custom fields configured in Masters → Lead Settings, keyed
  /// by field id. The system fields live in columns of their own.
  customFields      Json?
  score             Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  stage       LeadStage   @relation(fields: [stageId], references: [id])
  owner       User?       @relation("LeadOwner", fields: [ownerId], references: [id])
  lostReason  LostReason? @relation(fields: [lostReasonId], references: [id])
  duplicateOf Lead?       @relation("LeadDuplicate", fields: [duplicateOfId], references: [id])
  duplicates  Lead[]      @relation("LeadDuplicate")

  companies LeadCompany[]
  followUps LeadFollowUp[]
  notes     LeadNote[]
  documents LeadDocument[]

  @@index([stageId, ownerId])
  @@index([phone])
  @@index([nextActionAt])
  @@map("leads")
}

/// The companies a lead is tagged for — the SOW's "multiple company tagging".
model LeadCompany {
  leadId    String
  companyId String
  createdAt DateTime @default(now())

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])

  @@id([leadId, companyId])
  @@index([companyId])
  @@map("lead_companies")
}

/// Attendance for a day, per the design's three marks.
enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
}

/// How someone is engaged — "Company Staff", "Contract Role", "Direct Labour".
/// Configurable, and refused deletion while an employee still carries it.
model EmploymentType {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]

  @@map("employment_types")
}

/// Someone on site or in the office. Distinct from User: a User signs in, an
/// Employee is a person whose attendance is kept. Most direct labour never
/// gets a login.
model Employee {
  id               String    @id @default(cuid())
  employeeCode     String    @unique
  name             String
  mobile           String
  altContact       String?
  /// Aadhaar is mandatory in the design's form, alongside name, mobile, photo.
  aadhaar          String
  pan              String?
  address          String?
  employmentTypeId String
  designationId    String?
  photoKey         String?
  status           String    @default("ACTIVE")
  joinedOn         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employmentType EmploymentType     @relation(fields: [employmentTypeId], references: [id])
  designation    Designation?       @relation(fields: [designationId], references: [id])
  documents      EmployeeDocument[]
  attendance     AttendanceEntry[]

  @@index([employmentTypeId])
  @@map("employees")
}

/// The design gives an employee two document slots: Aadhaar card and PAN card.
model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  kind         String
  storageKey   String
  fileName     String
  fileSize     Int      @default(0)
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id])

  @@unique([employeeId, kind])
  @@map("employee_documents")
}

/// One employee, one day. The unique pair is what makes marking idempotent —
/// re-marking a day corrects it rather than stacking a second row.
model AttendanceEntry {
  id            String           @id @default(cuid())
  employeeId    String
  attendanceOn  DateTime         @db.Date
  status        AttendanceStatus
  overtimeHours Decimal          @default(0) @db.Decimal(5, 2)
  notes         String?
  markedById    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  markedBy User?    @relation(fields: [markedById], references: [id])

  @@unique([employeeId, attendanceOn])
  @@index([attendanceOn])
  @@map("attendance_entries")
}

/// A free-text note on a lead — the Notes tab of the lead detail. Kept apart
/// from follow-ups: a follow-up is a scheduled interaction, a note is a remark.
model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@map("lead_notes")
}

/// KYC documents and brochures attached to a lead, stored through lib/storage.
model LeadDocument {
  id           String   @id @default(cuid())
  leadId       String
  title        String
  storageKey   String
  fileName     String
  fileSize     Int      @default(0)
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([leadId])
  @@map("lead_documents")
}

model LeadFollowUp {
  id           String    @id @default(cuid())
  leadId       String
  userId       String
  /// CALL | WHATSAPP | MEETING
  channel      String    @default("CALL")
  /// The stage the lead was in when this follow-up was logged.
  stageId      String?
  notes        String
  outcome      String?
  nextActionAt DateTime?
  completedAt  DateTime  @default(now())
  createdAt    DateTime  @default(now())

  lead  Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id])
  stage LeadStage? @relation(fields: [stageId], references: [id])

  @@index([leadId])
  @@map("lead_follow_ups")
}

// --------------------------------- Tasks ------------------------------------

/// The scope document's lifecycle. Pending → Accepted → Started → Completed →
/// Closed for a standalone task; a checklist task inserts Under Review and
/// Under Approval before Closed, and Rework sends it back to the Assignee.
enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

/// A unit of work one person assigns to another, owned by the Assigner until
/// it closes. A checklist task is the same record with checklists and levels
/// hung off it.
/// A unit of work Admin assigns to one or more Team Leaders, who move it
/// Open → In Progress → Done with remarks along the way.
model Task {
  id          String       @id @default(cuid())
  taskNo      String       @unique
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  dueAt       DateTime
  startedAt   DateTime?
  completedAt DateTime?
  /// Remark given when the task was marked done.
  completionRemark String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("TaskCreatedBy", fields: [createdById], references: [id])

  assignees   TaskAssignee[]
  events      TaskEvent[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([status])
  @@index([createdById])
  @@index([dueAt])
  @@map("tasks")
}

/// One Team Leader on a task. A task assigned to three TLs has three rows,
/// so each can be reported on and notified on their own.
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation("TaskAssigneeUser", fields: [userId], references: [id])

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

/// Everything that happened to a task, in order: who, what, when.
model TaskEvent {
  id         String      @id @default(cuid())
  taskId     String
  actorId    String
  /// STATUS | COMMENT | EXTENSION | LEVEL | REASSIGN | REOPEN
  kind       String
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  summary    String
  remark     String?
  createdAt  DateTime    @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation("TaskEventActor", fields: [actorId], references: [id])

  @@index([taskId, createdAt])
  @@map("task_events")
}

/// One thread per task. An edit keeps what it replaced.
model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author      User              @relation("TaskCommentAuthor", fields: [authorId], references: [id])
  edits       TaskCommentEdit[]
  attachments TaskAttachment[]

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskCommentEdit {
  id        String   @id @default(cuid())
  commentId String
  /// What the comment said before this edit.
  body      String
  editedAt  DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
  @@map("task_comment_edits")
}

/// A file on the task itself, on a comment, or on an extension request.
model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  commentId    String?
  storageKey   String
  fileName     String
  fileSize     Int
  mimeType     String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment    TaskComment?   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation("TaskAttachmentBy", fields: [uploadedById], references: [id])

  @@index([taskId])
  @@map("task_attachments")
}

